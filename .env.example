# Verbara Web — environment variables template
#
# Copy this file to `.env.local` (gitignored) for local development.
# Production / preview deploys inject these via the deployment platform
# (e.g. CI secrets + nginx env substitution at container startup).
#
# Variables prefixed with VITE_* are inlined into the client bundle at build
# time (see https://vite.dev/guide/env-and-mode.html). Do not put secrets here.
# Variables WITHOUT the VITE_ prefix are read by build tooling (vite.config.ts,
# Sentry source-map upload) and never reach the browser.

# ─────────────────────────────────────────────────────────────────────────────
# Tenant defaults
# ─────────────────────────────────────────────────────────────────────────────

# Default tenant ID seeded into the tenant store on first load. Override in
# .env.local for testing against alternate demo tenants.
VITE_DEFAULT_TENANT_ID=demo

# ─────────────────────────────────────────────────────────────────────────────
# Sentry error tracking (Track 1E, v1.14.4) — optional
# ─────────────────────────────────────────────────────────────────────────────
# When VITE_SENTRY_DSN is empty, Sentry is a complete no-op (no init, no
# overhead, no requests). Local dev typically leaves this empty. Set it in
# .env.local if you want to verify Sentry capture during development.

# DSN from your Sentry project settings (Settings → Projects → <project> →
# Client Keys (DSN)). Format: https://<key>@<org>.ingest.sentry.io/<project>
VITE_SENTRY_DSN=

# Environment label attached to events (defaults to Vite MODE if empty).
# Common values: development, staging, production.
VITE_SENTRY_ENVIRONMENT=

# Release identifier — typically the git short SHA or package.json version.
# Sentry uses this to attribute errors to a specific release for source-map
# resolution and regression tracking.
VITE_APP_VERSION=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry source-map upload (build-time only, NEVER inlined in bundle)
# ─────────────────────────────────────────────────────────────────────────────
# These three are read by vite.config.ts during `npm run build`. When all
# three are set, the @sentry/vite-plugin uploads source maps to Sentry so
# stack traces in the dashboard show original TypeScript instead of minified
# JS. When any is missing, the plugin is a no-op (build still succeeds; just
# no upload).
#
# Provide via CI secrets only. Never commit values to .env.local.

# Sentry auth token with project:write + project:releases scopes.
# Generate at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# Sentry organization slug.
SENTRY_ORG=

# Sentry project slug for the Web app.
SENTRY_PROJECT=
