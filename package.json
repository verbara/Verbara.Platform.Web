{
  "name": "verbara-web",
  "private": true,
  "version": "3.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && npm run i18n:check",
    "i18n:check": "node scripts/i18n-parity-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test -c tests/e2e/playwright.config.ts --headed",
    "e2e:debug": "playwright test -c tests/e2e/playwright.config.ts --debug",
    "prepare": "husky",
    "build:webchat-sdk": "vite build --config vite.webchat-sdk.config.ts",
    "build:webchat-embed": "vite build --config vite.webchat-embed.config.ts",
    "build:webchat": "npm run build:webchat-sdk && npm run build:webchat-embed",
    "build:all": "npm run build && npm run build:webchat",
    "dev:webchat-demo": "vite preview --port 4173 --outDir public/webchat/embed"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@wavesurfer/react": "^1.0.12",
    "@xyflow/react": "^12.10.2",
    "ag-grid-community": "^35.3.0",
    "ag-grid-react": "^35.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "html2canvas": "^1.4.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "libphonenumber-js": "^1.13.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.8",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^7.12.6",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.60.0",
    "@sentry/react": "^10.53.1",
    "@sentry/vite-plugin": "^5.2.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "otpauth": "^9.5.1",
    "otplib": "^13.4.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
