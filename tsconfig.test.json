{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    /* vitest also collects .js/.jsx/.mjs/.cjs tests; checkJs type-checks those too. */
    "allowJs": true,
    "checkJs": true
  },
  /* Every file vitest collects (vitest.config.ts: its default include, any .test or .spec
     file ending in .js/.jsx/.mjs/.cjs/.ts/.tsx/.mts/.cts, minus the Playwright folders), so
     `tsc -b` type-checks each unit test whatever its extension; plus the shared test helpers. */
  "include": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/test",
    "tests/unit",
    "tests/**/*.test.*",
    "tests/**/*.spec.*"
  ],
  "exclude": ["tests/e2e", "tests/manuales", "tests/fixtures"]
}
