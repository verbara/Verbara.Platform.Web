#!/bin/sh
# Sourced by the nginx image's entrypoint at start-up (it runs scripts in
# /docker-entrypoint.d/ whenever the command is nginx). Writes the file that
# nginx.conf includes in its http block: `upstream verbara_realtime`, the
# host:port of the SignalR realtime service, which /hubs/ proxies to.
#
# The upstream keeps a pool of idle connections (`keepalive`, see nginx.conf),
# and the image must start whether or not the realtime service exists. How
# the server is written depends on how its name can be looked up:
#
#   - an IPv4 address, or a name /etc/hosts lists: a plain server. nginx
#     reads it once at start-up (the system lookup reads /etc/hosts), and it
#     cannot change while the container runs. nginx's own resolver never
#     reads /etc/hosts, so `resolve` would leave such a name unresolved.
#   - any other name, with a nameserver in resolv.conf: the server carries
#     `resolve`, with those nameservers as its resolver. nginx starts even
#     where no realtime service exists, looks the name up again every 10 s,
#     and /hubs/ answers 502 until it resolves. `resolve` needs a shared-memory
#     `zone` and nginx 1.27.3 or later (the Dockerfile fails the build on an
#     older base).
#   - any other name, with no nameserver: nothing could look it up after
#     start-up, and a plain server whose name does not resolve stops nginx
#     from starting. The server is written `down`, so nginx starts and /hubs/
#     answers 502 until the container is restarted with a nameserver or with
#     the name in /etc/hosts.
#
# VERBARA_REALTIME_UPSTREAM (host:port) overrides the default. nginx's own
# resolver does not apply resolv.conf's search domains, so a bare Service name
# does not resolve on Kubernetes; there the first search domain is the pod's
# <namespace>.svc.cluster.local, and the Helm chart names the Service
# platform-realtime. Elsewhere (compose) the service is `realtime`.
#
# The file goes under /var/run: the Helm chart runs this image with a
# read-only root filesystem and mounts an emptyDir there.

verbara_out=/var/run/verbara-realtime-upstream.conf

verbara_upstream=${VERBARA_REALTIME_UPSTREAM:-}
if [ -z "$verbara_upstream" ]; then
  if [ -n "${KUBERNETES_SERVICE_HOST:-}" ]; then
    verbara_search=$(awk '$1 == "search" { print $2; exit }' /etc/resolv.conf)
    verbara_upstream="platform-realtime${verbara_search:+.$verbara_search}:5030"
  else
    verbara_upstream="realtime:5030"
  fi
fi

verbara_host=${verbara_upstream%:*}
verbara_port=${verbara_upstream##*:}
case "$verbara_host:$verbara_port" in
  *[!A-Za-z0-9.:-]* ) verbara_bad=1 ;;
esac
case "$verbara_port" in
  '' | *[!0-9]* ) verbara_bad=1 ;;
esac
case "$verbara_host" in
  '' | *:* ) verbara_bad=1 ;;
esac
if [ "$verbara_upstream" != "$verbara_host:$verbara_port" ] || [ -n "${verbara_bad:-}" ]; then
  echo "18-verbara-realtime-upstream.envsh: VERBARA_REALTIME_UPSTREAM must be host:port, got '$verbara_upstream'" >&2
  return 1
fi

verbara_resolvers=$(awk 'BEGIN { ORS = " " } $1 == "nameserver" { if ($2 ~ ":") print "[" $2 "]"; else print $2 }' /etc/resolv.conf)
verbara_resolvers=${verbara_resolvers% }

if echo "$verbara_host" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' ||
  awk -v h="$verbara_host" '
    { sub(/#.*/, "") }
    { for (i = 2; i <= NF; i++) if (tolower($i) == tolower(h)) found = 1 }
    END { exit !found }' /etc/hosts 2>/dev/null; then
  verbara_lookup=static
elif [ -n "$verbara_resolvers" ]; then
  verbara_lookup=resolve
else
  verbara_lookup=unresolvable
  echo "18-verbara-realtime-upstream.envsh: $verbara_host is not in /etc/hosts and resolv.conf has no nameserver; /hubs/ answers 502" >&2
fi

{
  echo "# Written by 18-verbara-realtime-upstream.envsh at start-up."
  echo "upstream verbara_realtime {"
  echo "    zone verbara_realtime 64k;"
  if [ "$verbara_lookup" = static ]; then
    echo "    server $verbara_upstream;"
  elif [ "$verbara_lookup" = resolve ]; then
    echo "    resolver $verbara_resolvers valid=10s;"
    echo "    server $verbara_upstream resolve;"
  else
    echo "    # $verbara_host has no address in /etc/hosts and resolv.conf has no nameserver."
    echo "    server 127.0.0.1:$verbara_port down;"
  fi
  echo "    keepalive 64;"
  echo "}"
} > "$verbara_out"

echo "18-verbara-realtime-upstream.envsh: /hubs/ upstream $verbara_upstream (lookup: $verbara_lookup, resolver: ${verbara_resolvers:-none})"
unset verbara_out verbara_upstream verbara_search verbara_resolvers verbara_host verbara_port verbara_bad verbara_lookup
